# 发布签名配置 —— 把本文件复制为 keystore.properties 后填入自己的值。
#
# ⚠️ keystore.properties 与 .jks 都已加入 .gitignore，绝不进版本库。
# ⚠️ 这里的内容一旦丢失：无法再给已安装的用户发升级包（只能让所有人卸载重装，数据全丢）。
#    建议：口令记在密码管理器里，.jks 至少存两处离线备份（U 盘 + 网盘加密压缩包）。
#
# 生成密钥（在工程根目录执行，需 JDK 17 的 keytool）：
#   keytool -genkeypair -v \
#     -keystore keystore/vaultbook-release.jks \
#     -alias vaultbook \
#     -keyalg RSA -keysize 4096 -validity 10000 \
#     -storetype PKCS12 \
#     -storepass <你的口令> -keypass <同一个口令> \
#     -dname "CN=VaultBook,OU=Personal,O=YG,C=CN"
#
# PKCS12 格式下 storePassword 与 keyPassword 必须相同，这是格式限制不是笔误。

# 路径可以相对工程根目录，也可以相对 app/ 目录，两种写法都支持
storeFile=keystore/vaultbook-release.jks
storePassword=在这里填口令
keyAlias=vaultbook
keyPassword=在这里填口令（PKCS12 要求与 storePassword 相同）
