<?xml version="1.0" encoding="utf-8"?>
<!--
  桌面小组件（4×2）的布局：头部 + 三行记录 + 空态。

  四条 RemoteViews 的硬限制决定了这里的写法，改之前先看一眼：

  1. **只能用 RemoteViews 支持的控件**：LinearLayout / RelativeLayout /
     FrameLayout / GridLayout + TextView / ImageView / Button / ProgressBar 这一套。
     ConstraintLayout、Space、裸 View 都不在列表里，inflate 会直接崩。
     需要撑开空间就靠 TextView 的 layout_weight。
  2. **没有主题**：RemoteViews 在桌面进程里渲染，拿不到本应用的 MaterialTheme，
     颜色只能写字面值。这里 5 个色值与 ui/theme/Theme.kt 的浅色方案手工对齐，
     **改主题时要同步改这里**。
  3. **不能 `<include>` 复用行布局**：include 覆盖 id 只会改根节点 id，
     行内的 `widget_row_title` 在 4 份副本里会撞成同一个 id，
     `findViewById` 永远只拿到第一份。所以三行是**逐行展开、id 各自独立**的。
  4. **行数是写死的**：不足三行时由 VaultWidgetProvider 把多余行
     `setViewVisibility(View.GONE)` 掉，不是动态创建。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="11dp"
    android:paddingEnd="14dp"
    android:paddingBottom="9dp">

    <!-- 头部：「VaultBook」占满剩余宽度，「＋新建」靠右 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_title"
            android:textColor="#161B19"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_new"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pill_bg"
            android:paddingStart="9dp"
            android:paddingTop="3dp"
            android:paddingEnd="9dp"
            android:paddingBottom="3dp"
            android:text="@string/widget_new"
            android:textColor="#0B6E4F"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 第 1 行 -->
    <LinearLayout
        android:id="@+id/widget_row1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_row_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingTop="5dp"
        android:paddingEnd="6dp"
        android:paddingBottom="5dp">

        <TextView
            android:id="@+id/widget_row1_initial"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/widget_avatar_bg"
            android:gravity="center"
            android:textColor="#0B6E4F"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_row1_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#161B19"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_row1_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#7A857E"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 第 2 行 -->
    <LinearLayout
        android:id="@+id/widget_row2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_row_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingTop="5dp"
        android:paddingEnd="6dp"
        android:paddingBottom="5dp">

        <TextView
            android:id="@+id/widget_row2_initial"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/widget_avatar_bg"
            android:gravity="center"
            android:textColor="#0B6E4F"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_row2_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#161B19"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_row2_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#7A857E"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 第 3 行 -->
    <LinearLayout
        android:id="@+id/widget_row3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_row_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingTop="5dp"
        android:paddingEnd="6dp"
        android:paddingBottom="5dp">

        <TextView
            android:id="@+id/widget_row3_initial"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/widget_avatar_bg"
            android:gravity="center"
            android:textColor="#0B6E4F"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_row3_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#161B19"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_row3_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#7A857E"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 缓存为空时显示，三行全部隐藏 -->
    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/widget_empty"
        android:textColor="#7A857E"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
